# LaoTrace Environment Configuration
# Copy this file to .env or .env.local to customize local ports and endpoints

# 1. Smart Contract Address (Deployed on LAB Chain Chain ID: 5222)
VITE_CONTRACT_ADDRESS=0xee891fb89CaD3D643a029fF6b4BD0addc6E4d8Cc

# 2. Blockchain Network Details
VITE_CHAIN_ID=5222
VITE_RPC_URL=https://rpc.labchain.la
VITE_BLOCK_EXPLORER_URL=https://explorer.labchain.la

# 3. Python AI Service (EUDR Satellite Sentinel-2 & e-Phyto OCR - Port 5000)
VITE_PYTHON_AI_URL=http://localhost:5000

# 4. Go Backend Base URL (Port 4001)
VITE_BACKEND_API_URL=http://localhost:4001/api/v1
